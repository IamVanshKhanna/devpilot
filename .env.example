# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI
# AI_BACKEND: auto | nvidia | openrouter | ollama | mock
#   auto    -> use paid key if present, else local Ollama, else mock (FREE, no key)
#   mock    -> deterministic offline comments (FREE, no network) — great for demos/CI
#   ollama  -> local Ollama OpenAI-compatible endpoint (FREE, no key)
#   nvidia/openrouter -> paid cloud API (requires the matching key below)
AI_BACKEND=auto
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-pro
# Ollama (local, free) — point at your Pi: http://<pi-ip>:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Database
DATABASE_URL=postgresql://devpilot:**@postgres:5432/devpilot

# Redis
REDIS_URL=redis://redis:6379

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=